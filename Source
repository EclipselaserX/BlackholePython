                    pygame.event.set_grab(False)

    keys = pygame.key.get_pressed()

    if surf_active:
        dir_x = math.cos(surf_pitch) * math.cos(surf_yaw)
        dir_y = math.sin(surf_pitch)
        dir_z = math.cos(surf_pitch) * math.sin(surf_yaw)
        forward = np.array([dir_x, dir_y, dir_z])
        world_up = np.array([0.0, 1.0, 0.0])
        right = normalize_vec(np.cross(forward, world_up))

        if keys[pygame.K_w]: target_surf_pos += forward * surf_speed * dt_frame
        if keys[pygame.K_s]: target_surf_pos -= forward * surf_speed * dt_frame
        if keys[pygame.K_a]: target_surf_pos -= right * surf_speed * dt_frame
        if keys[pygame.K_d]: target_surf_pos += right * surf_speed * dt_frame
        if keys[pygame.K_e]: target_surf_pos += world_up * surf_speed * dt_frame
        if keys[pygame.K_q]: target_surf_pos -= world_up * surf_speed * dt_frame
        if keys[pygame.K_r]: target_surf_tilt -= 1.8 * dt_frame
        if keys[pygame.K_t]: target_surf_tilt += 1.8 * dt_frame
    else:
        if keys[pygame.K_a]: target_tilt -= 1.8 * dt_frame
        if keys[pygame.K_d]: target_tilt += 1.8 * dt_frame

        if keys[pygame.K_LEFT]:
            blackholes[selected_bh_idx]["ring_sharpness"] = min(1000.0,
                                                                blackholes[selected_bh_idx]["ring_sharpness"] + 8.0)
        if keys[pygame.K_RIGHT]:
            blackholes[selected_bh_idx]["ring_sharpness"] = max(40.0,
                                                                blackholes[selected_bh_idx]["ring_sharpness"] - 8.0)

        if keys[pygame.K_w]: bloom_intensity = min(4.0, bloom_intensity + 0.08)
        if keys[pygame.K_s]: bloom_intensity = max(0.0, bloom_intensity - 0.08)
        target_mouse_x = target_mouse_x % 1.0

    pos, direct, up, right = compute_camera_vectors()

    if tidal_force > 0.01:
        shake_amplitude = 0.35 * (tidal_force ** 2)
        jitter_vec = np.array([
            (np.random.rand() - 0.5),
            (np.random.rand() - 0.5),
            (np.random.rand() - 0.5)
        ]) * shake_amplitude
        pos = pos + jitter_vec

    target_exposure = calculate_adaptive_exposure(pos, direct)
    update_interpolations(dt_frame)

    ctx.clear(0.0, 0.0, 0.0)
    upload_uniform_blocks(SCREEN_WIDTH, SCREEN_HEIGHT, pos, direct, up, right)
    vao.render(moderngl.TRIANGLES)

    if render_ui_to_surface():
        ui_data = pygame.image.tostring(ui_surface, "RGBA", True)

        if not ui_texture:
            ui_texture = ctx.texture((SCREEN_WIDTH, SCREEN_HEIGHT), 4, data=ui_data)
            ui_texture.filter = (moderngl.LINEAR, moderngl.LINEAR)
        else:
            ui_texture.write(ui_data)

        ctx.enable(moderngl.BLEND)
        ui_texture.use(0)
        ui_vao.render(moderngl.TRIANGLES)
        ctx.disable(moderngl.BLEND)

    pygame.display.flip()

if ui_texture:
    ui_texture.release()
pygame.quit()
sys.exit()
