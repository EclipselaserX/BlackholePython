def save_cinematic_screenshot():
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)
    target_dir = filedialog.askdirectory(title="Select Save Directory for 4K UHD Screenshot")
    root.destroy()

    if not target_dir:
        return

    ss_width = 3840
    ss_height = int(ss_width / 2.39)
    ss_height = ss_height - (ss_height % 2)

    render_target = ctx.texture((ss_width, ss_height), 4)
    fbo = ctx.framebuffer(color_attachments=[render_target])
    fbo.use()
    ctx.clear(0.0, 0.0, 0.0)

    c_pos, c_dir, c_up, c_right = compute_camera_vectors()
    upload_uniform_blocks(ss_width, ss_height, c_pos, c_dir, c_up, c_right)

