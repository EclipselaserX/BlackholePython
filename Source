def update_interpolations(dt):
    global mouse_x, mouse_y, zoom, tilt, speed_multiplier, bloom_intensity
    global lens_strength, star_density
    global surf_pos, surf_yaw, surf_pitch, surf_tilt
    global current_exposure, target_exposure, ui_animation_progress
    global camera_target

    blend = 1.0 - math.exp(-smoothing_factor * dt)

    camera_target += (target_camera_target - camera_target) * blend
    mouse_x += (target_mouse_x - mouse_x) * blend
    mouse_y += (target_mouse_y - mouse_y) * blend
    zoom += (target_zoom - zoom) * blend
    tilt += (target_tilt - tilt) * blend
    speed_multiplier += (target_speed_multiplier - speed_multiplier) * blend
    bloom_intensity += (target_bloom_intensity - bloom_intensity) * blend
    lens_strength += (target_lens_strength - lens_strength) * blend
    star_density += (target_star_density - star_density) * blend

    current_exposure = current_exposure + (target_exposure - current_exposure) * (1.0 - math.exp(-3.5 * dt))

    ui_target = 1.0 if ui_open else 0.0
    ui_animation_progress += (ui_target - ui_animation_progress) * (1.0 - math.exp(-12.0 * dt))

    if surf_active:
        surf_pos += (target_surf_pos - surf_pos) * blend
        surf_yaw += (target_surf_yaw - surf_yaw) * blend
        surf_pitch += (target_surf_pitch - surf_pitch) * blend
        surf_tilt += (target_surf_tilt - surf_tilt) * blend


def compute_camera_vectors():
    if surf_active:
        dir_x = math.cos(surf_pitch) * math.cos(surf_yaw)
        dir_y = math.sin(surf_pitch)
        dir_z = math.cos(surf_pitch) * math.sin(surf_yaw)
        cam_dir = np.array([dir_x, dir_y, dir_z])

        world_up = np.array([0.0, 1.0, 0.0])
        cam_right = np.cross(cam_dir, world_up)

        if np.linalg.norm(cam_right) < 0.001:
            cam_right = np.array([1.0, 0.0, 0.0])
        else:
            cam_right = cam_right / np.linalg.norm(cam_right)

        up_temp = np.cross(cam_right, cam_dir)
        cam_up = up_temp * math.cos(surf_tilt) + cam_right * math.sin(surf_tilt)
        final_right = normalize_vec(np.cross(cam_dir, cam_up))
        final_up = normalize_vec(np.cross(final_right, cam_dir))

        return surf_pos, cam_dir, final_up, final_right
    else:
        theta = mouse_y * math.pi
        phi = mouse_x * 2.0 * math.pi
        ro = camera_target + np.array(
            [math.sin(theta) * math.sin(phi), math.cos(theta), math.sin(theta) * math.cos(phi)]) * zoom

        ww = normalize_vec(camera_target - ro)
        base_up = np.array([0.0, 1.0, 0.0])
        right_temp = normalize_vec(np.cross(ww, base_up))
        up_temp = np.cross(right_temp, ww)

        cam_up = up_temp * math.cos(tilt) + right_temp * math.sin(tilt)
        uu = normalize_vec(np.cross(ww, cam_up))
        vv = normalize_vec(np.cross(uu, ww))
        return ro, ww, vv, uu


def project_3d_to_2d(bh_pos, cam_pos, cam_dir, cam_up, cam_right, width, height):
    to_bh = bh_pos - cam_pos
    dist_forward = np.dot(to_bh, cam_dir)
    if dist_forward <= 0.2:
        return None

    proj_x = np.dot(to_bh, cam_right) / dist_forward * 2.0
    proj_y = np.dot(to_bh, cam_up) / dist_forward * 2.0

    aspect = width / height
    screen_x = ((proj_x / aspect) + 1.0) * 0.5 * width
    screen_y = (1.0 - (proj_y + 1.0) * 0.5) * height
    return int(screen_x), int(screen_y)


def normalize_vec(v):
    norm = np.linalg.norm(v)
    return v if norm == 0 else v / norm


