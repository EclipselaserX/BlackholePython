float hash(vec3 p) {
    p = fract(p * vec3(443.8975, 397.2973, 491.1871));
    p += dot(p.xyz, p.yzx + 19.19);
    return fract(p.x * p.y * p.z);
}

float noise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f*f*(3.0-2.0*f);
    return mix(mix(mix(hash(i + vec3(0,0,0)), hash(i + vec3(1,0,0)), f.x),
                   mix(hash(i + vec3(0,1,0)), hash(i + vec3(1,1,0)), f.x), f.y),
               mix(mix(hash(i + vec3(0,0,1)), hash(i + vec3(1,0,1)), f.x),
                   mix(hash(i + vec3(0,1,1)), hash(i + vec3(1,1,1)), f.x), f.y), f.z);
}

float deep_fbm(vec3 p, float turb_scale) {
    float v = 0.0;
    float a = 0.55;
    vec3 shift = vec3(100.0);
    if (u_low_quality == 0) {
        p += noise3D(p * 0.5) * 0.35;
    }

    int octaves = (u_low_quality == 1) ? 3 : 6;
    for (int i = 0; i < octaves; i++) {
        v += a * noise3D(p);
        p = p * 2.25 + shift;
        a *= 0.45;
    }
    return v;
}

float get_volumetric_debris(vec3 sample_pos, float r, float dist_to_cam, float outer_fade, float turb_scale) {
    float speed = (5.0 / (r + 0.5)) * u_time;
    float cos_s = cos(speed);
    float sin_s = sin(speed);
    vec3 sheared_p = vec3(
        sample_pos.x * cos_s - sample_pos.z * sin_s,
        sample_pos.y,
        sample_pos.x * sin_s + sample_pos.z * cos_s
    );
    float radial_drift = noise3D(sheared_p * 0.5 + vec3(0.0, 0.0, u_time * 0.15));
    sheared_p += normalize(vec3(sheared_p.x, 0.0, sheared_p.z)) * radial_drift * u_time * 0.25;

    float lod_factor = smoothstep(22.0, 4.0, dist_to_cam);
    float macro_noise = deep_fbm(sheared_p * 0.75, turb_scale);

    vec3 micro_p = sheared_p * vec3(4.5, 9.0, 4.5) * turb_scale;
    float micro_clumps = noise3D(micro_p + vec3(0.0, u_time * 0.2, 0.0));

    float vertical_displacement = micro_clumps * 0.35 * lod_factor * outer_fade;
    sheared_p.y += vertical_displacement;

    float filament_striations = abs(sin(r * 4.0 - (atan(sample_pos.z, sample_pos.x) * 3.0) + macro_noise * 4.0));
    float debris_gaps = smoothstep(0.15, 0.7, filament_striations);

    float final_structure = mix(macro_noise, macro_noise * debris_gaps * (0.4 + 0.6 * micro_clumps), outer_fade * 0.9);
    return final_structure;
}

float get_star_field(vec3 rd) {
    float stars = 0.0;
    float dense_mod = (u_low_quality == 1) ? 0.65 : 1.0; 
    vec3 p1 = rd * 140.0;
    if (hash(floor(p1)) > (1.0 - 0.006 * u_star_density * dense_mod)) stars += pow(smoothstep(0.7, 1.0, hash(p1)), 6.0) * 1.5;
    vec3 p2 = rd * 380.0;
    if (hash(floor(p2)) > (1.0 - 0.003 * u_star_density * dense_mod)) stars += pow(smoothstep(0.8, 1.0, hash(p2)), 4.0) * 0.9;
    return stars;
}

vec4 raymarch_scene(vec3 ro, vec3 rd, float color_shift_factor) {
    vec3 p = ro;
    vec3 acc_color = vec3(0.0);
    float optical_depth = 0.0;

    float min_r_global = 9999.0;
    int global_closest_j = 0;
    bool hit_horizon_global = false;

    vec3 total_bloom = vec3(0.0);
    float slow_time = u_time * 0.4;

    int max_engine_steps = (u_low_quality == 1) ? 128 : 320;
    int adaptive_max_steps = max_engine_steps;

    float closest_initial_r = 9999.0;
    for(int j=0; j<u_num_bh; j++) {
        closest_initial_r = min(closest_initial_r, length(p - u_bh_pos[j]));
    }

    if (u_low_quality == 0) {
        if (closest_initial_r > 80.0) { adaptive_max_steps = 180; }
        else if (closest_initial_r < 18.0) { adaptive_max_steps = 320; }
    } else {
        if (closest_initial_r > 80.0) { adaptive_max_steps = 96; }
        else if (closest_initial_r < 18.0) { adaptive_max_steps = 128; }
    }

    float extreme_proximity = smoothstep(18.0, 2.0, closest_initial_r);
    float dynamic_noise = noise3D(vec3(p.x * 0.1, p.y * 0.1, u_time * 1.8));
    float micro_lens_fluctuation = 1.0 + (dynamic_noise - 0.5) * 0.045; 

    for (int i = 0; i < max_engine_steps; i++) {
        if (i >= adaptive_max_steps) break;
        if (length(p - u_cam_pos) > 1500.0) break; // Massively increased render distance

        vec3 total_gravity = vec3(0.0);
        float min_step_r = 9999.0;
        int step_closest_j = 0;

        for (int j = 0; j < u_num_bh; j++) {
            vec3 to_bh = p - u_bh_pos[j];
            float r2 = dot(to_bh, to_bh);
            float r = sqrt(r2);

            if (r < min_step_r) {
                min_step_r = r;
                step_closest_j = j;
            }

            float dynamic_inner_edge = u_bh_shadow_size[j] - (4.0 / u_bh_ring_sharpness[j]);
            if (r < dynamic_inner_edge) {
                hit_horizon_global = true;
            }

            float bh_m = u_bh_shadow_size[j] / 3.0; 
            vec3 grav = -1.5 * bh_m * to_bh / (r2 * r) * u_bh_lens_strength[j] * u_lens_strength * micro_lens_fluctuation * color_shift_factor;
            total_gravity += grav;
        }

        if (hit_horizon_global) break;

        if (min_step_r < min_r_global) {
            min_r_global = min_step_r;
            global_closest_j = step_closest_j;
        }

        float base_dt = max(0.035, (min_step_r - 2.0) * 0.095);
        if (min_step_r > 60.0) { base_dt = 0.035 + (min_step_r - 2.0) * 0.25; } // Step faster when far away

        float proximity_to_disk = abs(p.y - u_bh_pos[step_closest_j].y);
        float dt = mix(base_dt * 0.4, base_dt, smoothstep(0.0, 1.2, proximity_to_disk));
        if (u_low_quality == 1) { dt *= 1.2; }

        rd = normalize(rd + total_gravity * dt);
        p += rd * dt;

        for (int j = 0; j < u_num_bh; j++) {
            vec3 to_bh = p - u_bh_pos[j];
            float r = length(to_bh);
            float isco = u_bh_shadow_size[j] * 2.0;
            float max_disk_r = isco * 4.3;

            if (u_bh_accretion_enabled[j] == 1) {
                float disk_height = mix(0.4, 0.95, smoothstep(isco, max_disk_r, r));
                if (abs(to_bh.y) < disk_height && r >= isco && r < max_disk_r) {
                    vec3 disk_vel = normalize(cross(vec3(0.0, 1.0, 0.0), to_bh));
                    float cos_alpha = dot(rd, disk_vel);
                    float rs_local = isco / 3.0;
                    float v = 1.0 / sqrt(max(rs_local + 0.1, r));
                    float gamma = 1.0 / sqrt(1.0 - v*v);
                    float step_doppler = 1.0 / (gamma * (1.0 - v * cos_alpha));
                    float step_redshift = sqrt(max(0.001, 1.0 - rs_local / r));
                    float step_beaming = pow(step_doppler, 3.5);

                    float texture_rotation = slow_time * (3.2 / (r * sqrt(r)));
                    float angle = atan(to_bh.z, to_bh.x) - texture_rotation;

                    vec3 noise_pos = vec3(cos(angle)*r, to_bh.y * 2.0, sin(angle)*r);
                    float dist_to_cam = distance(p, u_cam_pos);
                    float outer_fade = smoothstep(isco * 1.2, max_disk_r, r);

                    float volumetric_features = get_volumetric_debris(noise_pos, r, dist_to_cam, outer_fade, u_bh_turbulence[j]);
                    float base_density = smoothstep(max_disk_r, isco * 1.5, r) * smoothstep(isco - 0.2, isco + 1.5, r);
                    base_density *= (1.0 - abs(to_bh.y) / disk_height);

                    float dynamic_edge = mix(0.15, 0.38, outer_fade);
                    float final_density = base_density * smoothstep(dynamic_edge, 0.78, volumetric_features);

                    float density_shadow = exp(-final_density * 1.95);
                    final_density *= density_shadow;
                    float mouth_glow_factor = exp(-(r - isco) * 0.45);
                    vec3 inner_core_heat = vec3(1.5, 1.35, 1.1) * 3.5 * step_beaming;
                    vec3 outer_gas = vec3(0.98, 0.52, 0.18) * step_doppler * step_redshift;

                    vec3 current_gas_color = mix(outer_gas, inner_core_heat, mouth_glow_factor);
                    if (cos_alpha > 0.0) {
                        float blue_factor = smoothstep(0.0, 1.0, cos_alpha);
                        vec3 target_blue = vec3(0.35, 0.68, 1.0) * step_beaming * 1.5 * u_bh_doppler_blue[j];
                        current_gas_color = mix(current_gas_color, target_blue, blue_factor * (0.55 * (1.0 - mouth_glow_factor)));
                    }

                    vec3 extreme_plasma = vec3(0.65, 0.85, 1.0) * 9.0 * step_doppler;
                    current_gas_color = mix(current_gas_color, extreme_plasma, extreme_proximity * 0.9);

                    float step_absorption = final_density * dt * 1.45;
                    acc_color += exp(-optical_depth) * current_gas_color * step_absorption;
                    optical_depth += step_absorption;

                    if (optical_depth > 5.5) break;
                }

                float glow_range = max_disk_r;
                if (r >= isco - 1.2 && r < glow_range) {
                    vec3 disk_vel = normalize(cross(vec3(0.0, 1.0, 0.0), to_bh));
                    float cos_alpha = dot(rd, disk_vel);
                    float v = 1.0 / sqrt(max((isco/3.0) + 0.1, r));
                    float gamma = 1.0 / sqrt(1.0 - v*v);
                    float step_doppler = 1.0 / (gamma * (1.0 - v * cos_alpha));
                    float step_beaming = pow(step_doppler, 3.5);

                    float base_falloff = smoothstep(glow_range, isco, r) * (1.0 / (1.0 + abs(to_bh.y) * 3.5));
                    float inner_mouth_boost = exp(-(r - isco) * 0.35) * 2.0;

                    float bloom_layer1 = exp(-abs(to_bh.y) * 3.0) * base_falloff;
                    float bloom_layer2 = exp(-abs(to_bh.y) * 0.8) * base_falloff * 0.4;
                    float bloom_layer3 = exp(-abs(to_bh.y) * 0.15) * base_falloff * 0.08;
                    float combined_falloff = (bloom_layer1 + bloom_layer2 + bloom_layer3) * (1.0 + inner_mouth_boost);
                    vec3 localized_bloom_color = mix(vec3(0.98, 0.38, 0.12), vec3(1.0, 0.95, 0.85), step_beaming * 0.4);
                    total_bloom += exp(-optical_depth) * localized_bloom_color * combined_falloff * step_beaming * dt * 0.22 * u_bloom_intensity;
                }
            }
        }
    }

    acc_color += total_bloom;

    if (!hit_horizon_global && min_r_global < 1500.0) {
        float photon_ring_radius = u_bh_shadow_size[global_closest_j];
        float delta_r = abs(min_r_global - photon_ring_radius);
        float ring_density = exp(-delta_r * u_bh_ring_sharpness[global_closest_j]);
        vec3 ring_glow = vec3(1.0, 0.82, 0.55) * ring_density * 4.5;
        acc_color += exp(-optical_depth) * ring_glow;
    }

    // Deep Space 
    vec3 background = vec3(0.001, 0.0008, 0.002);
    if (!hit_horizon_global && optical_depth < 5.5) {
        float stars = get_star_field(normalize(rd));
        background += vec3(0.92, 0.95, 1.0) * stars;
    }

    float horizon_fade = smoothstep(u_bh_shadow_size[global_closest_j] - 0.2, u_bh_shadow_size[global_closest_j] + 0.1, min_r_global);
    vec3 composite = mix(acc_color, (acc_color + exp(-optical_depth) * background), horizon_fade);

    return vec4(composite, min_r_global);
}

void main() {
    float closest_cam_r = 9999.0;
    for(int j=0; j<u_num_bh; j++) {
        closest_cam_r = min(closest_cam_r, length(u_cam_pos - u_bh_pos[j]));
    }

    float tidal_force = smoothstep(18.0, 2.0, closest_cam_r);
    float aberration = 1.0 - tidal_force * 0.65 * dot(uv, uv);
    vec2 st = uv * vec2(u_resolution.x / u_resolution.y, 1.0) / max(0.1, aberration);

    // REMOVED WAVE RIPPLE TO FIX PIXELATED ARTIFACTS
    vec3 rd = normalize(st.x * u_cam_right + st.y * u_cam_up + 2.0 * u_cam_dir);
    vec3 p = u_cam_pos;

    // Core single pass raymarch (Pure, pristine shadow)
    vec4 core_sample = raymarch_scene(p, rd, 1.0);
    vec3 final_rgb = core_sample.rgb; // REMOVED 3-PASS CHROMATIC ABERRATION TO PREVENT JAGGY EDGES

    final_rgb *= u_exposure;
    float vignette = smoothstep(2.8, 0.1, length(uv)); 
    final_rgb *= mix(1.0, vignette, tidal_force * 0.95);

    final_rgb = vec3(1.0) - exp(-final_rgb * 1.8);
    final_rgb = pow(final_rgb, vec3(1.0 / 1.25));
    fragColor = vec4(final_rgb, 1.0);
}
"""

