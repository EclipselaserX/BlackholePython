    full_path = os.path.join(target_dir, f"Gargantua_MultiMatrix_4K_{int(time.time())}.png")
    pygame.image.save(ss_surface, full_path)
    print(f"Cinematic UHD 4K render exported successfully: {full_path}")
    ctx.screen.use()


# Initialize state parameters
running = True
ui_click_captured = False

while running:
    dt_frame = clock.tick(60) / 1000.0
    dt_frame = min(0.05, dt_frame)

    closest_dist = 9999.0
    for bh in blackholes:
        d = np.linalg.norm(surf_pos - bh["pos"]) if surf_active else 100.0
        if d < closest_dist:
            closest_dist = d

    tidal_force = 0.0

    if surf_active and closest_dist < 18.0:
        tidal_force = max(0.0, 1.0 - (closest_dist - 2.0) / 16.0)
        dt_frame *= (1.0 - tidal_force * 0.92)

    custom_time += dt_frame * speed_multiplier

    mouse_pos = pygame.mouse.get_pos()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        elif event.type == pygame.VIDEORESIZE:
            SCREEN_WIDTH, SCREEN_HEIGHT = event.w, event.h
            ctx.viewport = (0, 0, SCREEN_WIDTH, SCREEN_HEIGHT)
            ui_surface = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA)
            if ui_texture:
                ui_texture.release()
                ui_texture = None

        elif event.type == pygame.MOUSEBUTTONDOWN:
            if event.button == 1:
                ui_click_captured = handle_ui_clicks(mouse_pos, is_moving=False)
                if not ui_click_captured:
                    c_pos, c_dir, c_up, c_right = compute_camera_vectors()
                    closest_node_idx = -1
                    min_screen_dist = 99999.0

                    for idx, bh in enumerate(blackholes):
                        proj_coords = project_3d_to_2d(bh["pos"], c_pos, c_dir, c_up, c_right, SCREEN_WIDTH,
                                                       SCREEN_HEIGHT)
                        if proj_coords:
                            sx, sy = proj_coords
                            dist = math.hypot(mouse_pos[0] - sx, mouse_pos[1] - sy)
                            if dist < min_screen_dist:
                                min_screen_dist = dist
                                closest_node_idx = idx

                    if closest_node_idx != -1 and min_screen_dist < 90.0:
                        selected_bh_idx = closest_node_idx
                        target_camera_target = np.copy(blackholes[selected_bh_idx]["pos"])
                        print(f"Active Selection Switched -> Black Hole #{selected_bh_idx + 1}")
                    elif not surf_active:
                        is_dragging = True

            elif event.button == 2 and not ui_click_captured and not surf_active:
                is_panning = True

            elif event.button == 4 and not ui_click_captured:
                if surf_active:
                    surf_speed = min(150.0, surf_speed + 2.5)
                else:
                    target_zoom = max(10.0, target_zoom - 4.5)

            elif event.button == 5 and not ui_click_captured:
                if surf_active:
                    surf_speed = max(1.0, surf_speed - 2.5)
                else:
                    target_zoom = min(400.0, target_zoom + 4.5)

        elif event.type == pygame.MOUSEBUTTONUP:
            if event.button == 1:
                is_dragging = False
                ui_click_captured = False
                active_slider = None
            elif event.button == 2:
                is_panning = False

        elif event.type == pygame.MOUSEMOTION:
            if ui_click_captured:
                handle_ui_clicks(mouse_pos, is_moving=True)
            elif surf_active:
                dx, dy = event.rel
                target_surf_yaw += dx * mouse_sensitivity
                target_surf_pitch = max(-math.pi / 2.1, min(math.pi / 2.1, target_surf_pitch - dy * mouse_sensitivity))
            elif is_panning:
                dx, dy = event.rel
                c_pos, c_dir, c_up, c_right = compute_camera_vectors()
                pan_speed = zoom * 0.0015
                target_camera_target -= c_right * dx * pan_speed
                target_camera_target += c_up * dy * pan_speed
            elif is_dragging:
                dx, dy = event.rel
                target_mouse_x += dx * (0.45 / SCREEN_WIDTH)
                target_mouse_y = max(0.05, min(0.95, target_mouse_y - dy * (0.45 / SCREEN_HEIGHT)))

        elif event.type == pygame.KEYDOWN:
