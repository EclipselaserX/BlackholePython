    program['u_bh_accretion_enabled'].value = bh_accretion_enabled
    program['u_bh_doppler_blue'].value = bh_doppler_blue


def calculate_adaptive_exposure(c_pos, c_dir):
    if len(blackholes) == 0: return 1.0

    closest_dist = 9999.0
    closest_bh = blackholes[0]
    for bh in blackholes:
        dist = np.linalg.norm(c_pos - bh["pos"])
        if dist < closest_dist:
            closest_dist = dist
            closest_bh = bh

    target_norm = normalize_vec(closest_bh["pos"] - c_pos)
    alignment = max(0.0, float(np.dot(c_dir, target_norm)))
    proximity_intensity = 1.0 / max(1.0, closest_dist - 4.0)
    luminance_weight = alignment * proximity_intensity * 12.0
    clamped_target = 1.0 / (1.0 + luminance_weight)
    return max(0.08, min(1.8, clamped_target * 1.35))


