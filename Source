def handle_ui_clicks(m_pos, is_moving=False):
    global active_slider

    if ui_animation_progress < 0.05:
        return False

    panel_x = SCREEN_WIDTH - int(ui_width * ui_animation_progress)
    mx, my = m_pos

    if mx < panel_x:
        return False

    slider_w = 270
    slider_h = 8
    start_y = 135
    spacing = 68

    sliders = get_slider_defs()

    if not is_moving:
        active_slider = None
        for i, sld in enumerate(sliders):
            sy = start_y + i * spacing
            sx = panel_x + 35
            if sx <= mx <= sx + slider_w and sy - 12 <= my <= sy + slider_h + 12:
                active_slider = sld["id"]
                break

    if active_slider:
        sx = panel_x + 35
        pct = max(0.0, min(1.0, (mx - sx) / slider_w))
        bh = blackholes[selected_bh_idx]

        if active_slider == "shadow":
            bh["shadow_size"] = 0.5 + pct * (8.0 - 0.5)
        elif active_slider == "lens":
            bh["lens_strength"] = 0.0 + pct * (4.0 - 0.0)
        elif active_slider == "turb":
            bh["turbulence"] = 0.1 + pct * (3.5 - 0.1)
        elif active_slider == "doppler":
            bh["doppler_blue"] = 0.0 + pct * (3.0 - 0.0)
        elif active_slider == "thickness":
            bh["ring_sharpness"] = 1000.0 - pct * (1000.0 - 40.0)
        return True

    return True


